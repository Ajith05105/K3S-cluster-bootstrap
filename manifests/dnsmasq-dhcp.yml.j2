# Stores dnsmasq config, DHCP hook script, and Job template; hook triggers an Ansible Job when a new node joins
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dnsmasq-config
  namespace: kube-system
data:
  dnsmasq.conf: |
    port=0
    interface=eth0
    bind-interfaces
    dhcp-range={{ dhcp_range_start }},{{ dhcp_range_end }},{{ subnet_mask }},infinite
    no-resolv
    log-dhcp
    domain=cluster.local
    domain-needed
    bogus-priv
    dhcp-script=/scripts/join-node.sh
{% for host in groups['all'] %}
    dhcp-host={{ hostvars[host]['mac_address'] | default('') }},{{ hostvars[host]['ansible_host'] }},{{ host }}
{% endfor %}

  join-node.sh: |
    #!/bin/sh
    ACTION=$1
    MAC=$2
    IP=$3
    HOSTNAME=$4

    [ "$ACTION" != "add" ] && exit 0

    case "$HOSTNAME" in
      pi-server*) ROLE="server" ;;
      pi-agent*)  ROLE="agent"  ;;
      *) echo "Unknown hostname $HOSTNAME, skipping"; exit 0 ;;
    esac

    JOB_NAME="join-$(echo $IP | tr '.' '-')"
    kubectl get configmap dnsmasq-config -n kube-system \
      -o jsonpath='{.data.job-template\.yaml}' \
      | sed "s/__IP__/$IP/g; s/__MAC__/$MAC/g; s/__ROLE__/$ROLE/g; s/__NAME__/$JOB_NAME/g" \
      | kubectl apply -f -

  job-template.yaml: |
    apiVersion: batch/v1
    kind: Job
    metadata:
      name: __NAME__
      namespace: kube-system
    spec:
      ttlSecondsAfterFinished: 300
      template:
        spec:
          restartPolicy: Never
          serviceAccountName: dnsmasq-dhcp
          containers:
            - name: ansible-runner
              image: ansible-runner:latest
              imagePullPolicy: Never
              command:
                - ansible-playbook
                - -i
                - __IP__,
                - /playbooks/join_node.yml
                - -e
                - node_ip=__IP__
                - -e
                - node_role=__ROLE__
                - -e
                - node_mac=__MAC__
              volumeMounts:
                - name: ssh-key
                  mountPath: /root/.ssh/id_ed25519
                  subPath: id_ed25519
                - name: kubectl
                  mountPath: /usr/local/bin/kubectl
                - name: k3s-binary
                  mountPath: /tmp/k3s
                - name: k3s-install-script
                  mountPath: /tmp/k3s-install.sh
          volumes:
            - name: ssh-key
              secret:
                secretName: node-join-key
                defaultMode: 0600
            - name: kubectl
              hostPath:
                path: /usr/local/bin/kubectl
                type: File
            - name: k3s-binary
              hostPath:
                path: /usr/local/bin/k3s
                type: File
            - name: k3s-install-script
              hostPath:
                path: /home/{{ ansible_user }}/k3s-install.sh
                type: File

---
# SSH private key for ansible-runner Jobs to access new Pi nodes
apiVersion: v1
kind: Secret
metadata:
  name: node-join-key
  namespace: kube-system
type: Opaque
data:
  id_ed25519: {{ lookup('file', ansible_ssh_private_key_file | expanduser) | b64encode }}

---
# dnsmasq pod — runs on a master node, serves DHCP on the physical network
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dnsmasq-dhcp
  namespace: kube-system
spec:
  replicas: 1
  selector:
    matchLabels:
      app: dnsmasq-dhcp
  template:
    metadata:
      labels:
        app: dnsmasq-dhcp
    spec:
      hostNetwork: true
      serviceAccountName: dnsmasq-dhcp
      nodeSelector:
        node-role.kubernetes.io/control-plane: "true"
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          effect: NoSchedule
      containers:
        - name: dnsmasq
          image: dockurr/dnsmasq:latest
          imagePullPolicy: Never
          args: ["-C", "--no-daemon"]
          securityContext:
            capabilities:
              add: ["NET_ADMIN", "NET_RAW"]
          volumeMounts:
            - name: config
              mountPath: /etc/dnsmasq.conf
              subPath: dnsmasq.conf
            - name: scripts
              mountPath: /scripts
            - name: kubectl
              mountPath: /usr/local/bin/kubectl
      volumes:
        - name: config
          configMap:
            name: dnsmasq-config
            items:
              - key: dnsmasq.conf
                path: dnsmasq.conf
        - name: scripts
          configMap:
            name: dnsmasq-config
            defaultMode: 0755
            items:
              - key: join-node.sh
                path: join-node.sh
        - name: kubectl
          hostPath:
            path: /usr/local/bin/kubectl
            type: File
