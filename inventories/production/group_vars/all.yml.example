# Copy this file to all.yml and fill in your values
# DO NOT commit all.yml to git — it is gitignored

# SSH authentication (key-based, no passwords)
ansible_ssh_private_key_file: ~/.ssh/id_ed25519
ansible_user: pi

# Cluster secret — used to join agents to the server
k3s_token: changeme

# Network — laptop interface connected to the Pi switch
bootstrap_interface: en8
bootstrap_interface_ip: 192.168.1.100
dhcp_range_start: 192.168.1.200
dhcp_range_end: 192.168.1.254
subnet_mask: 255.255.255.0
gateway_ip: 192.168.1.1

# In-cluster dnsmasq — serves DHCP to agent nodes for the life of the
# cluster. Deliberately a different range from the laptop's bootstrap DHCP
# above, which only runs during prepare_nodes.yml.
cluster_dhcp_range_start: 192.168.1.101
cluster_dhcp_range_end: 192.168.1.199
cluster_dhcp_lease_time: infinite

# Advertised to DHCP clients as the NTP server (option 42). Self-joined
# agents never run node_prep, so this is the only way they learn about a time
# source. Run NTP off-cluster (e.g. on the NAT router Pi) so time keeps
# working even when the cluster is down.
cluster_ntp_server: 192.168.1.1

# kube-vip
kube_vip_version: "v0.9.0"
kube_vip_interface: eth0
kube_vip_vip: 192.168.1.50

# Helm (staged for the Pi during preflight)
helm_version: "v3.21.3"

# Gitea
gitea_version: "1.24.3"
gitea_chart_version: "12.5.0"
gitea_admin_username: admin
gitea_admin_password: changeme

# ArgoCD
argocd_namespace: argocd
argocd_version: "v3.4.5"
argocd_chart_version: "10.1.3"
dex_version: "v2.45.1"
redis_version: "8.2.3-alpine"
kube_vip_cloud_provider_version: "v0.0.12"
