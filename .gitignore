# Python virtualenv
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Ansible secrets and vault files
*.vault
vault_pass.txt
vault_password.txt
.vault_pass
.vault_password
*_vault.yml

# Ansible retry files
*.retry

# Ansible Galaxy roles (installed, not authored)
roles/requirements/
galaxy_roles/

# SSH keys
*.pem
*.key
id_rsa
id_ed25519
*.pub

# Kubeconfig files (may contain cluster credentials)
kubeconfig
kubeconfig-*
*.kubeconfig

# Sensitive inventory files (real IPs, credentials)
inventories/production/hosts.yml
inventories/production/group_vars/all.yml
inventories/production/group_vars/server.yml

#ignore helm manifests
manifests/gitea/gitea/

# Generated by preflight.yml — build output, not source.
# `kube-vip manifest daemonset` bakes --address {{ kube_vip_vip }} into the
# output, and preflight skips regeneration whenever the file already exists.
# Committing it therefore freezes ONE network's VIP into the repo for every
# clone — and for you too, the next time you change kube_vip_vip.
#
# kube-vip-rbac.yaml and kube-vip-cloud-controller.yaml stay committed on
# purpose: fetched upstream, no per-site values, so vendoring them pins content.
manifests/kube-vip/kube-vip-daemonset.yaml

# OS-generated files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
manifests/argocd/argo-cd/
