manifests/gitea/gitea/
manifests/monitoring/kube-prometheus-stack/

# Generated by preflight.yml — build output, not source.
# `kube-vip manifest daemonset` bakes --address {{ kube_vip_vip }} into the
# output, and preflight skips regeneration whenever the file already exists.
# Committing it therefore freezes ONE network's VIP into the repo for every
# clone — and for you too, the next time you change kube_vip_vip.
#
# It lives under roles/ rather than manifests/ ON PURPOSE: everything in
# manifests/ is rsynced into cluster-config and owned by ArgoCD with
# prune: true. A per-site generated file has no business in ArgoCD's desired
# state — any gap in that sync path and ArgoCD deletes your control-plane VIP,
# which is exactly what happened on 2026-09-01.
#
# kube-vip-rbac.yaml and kube-vip-cloud-controller.yaml stay in manifests/ and
# stay committed: fetched upstream, no per-site values, so ArgoCD can own them.
roles/deploy_kube_vip/files/kube-vip-daemonset.yaml

# OS-generated files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
manifests/argocd/argo-cd/
